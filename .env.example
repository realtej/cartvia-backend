# Spring
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/cartvia
DATABASE_USERNAME=cartvia
DATABASE_PASSWORD=cartvia

# JWT (use a strong random secret >= 32 characters in production)
JWT_SECRET=change-me-in-production-use-at-least-32-chars
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_EXPIRATION_MINUTES=30

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:8080

# WebSocket
WS_ENDPOINT=/ws
WS_ALLOWED_ORIGINS=*

# Payment (mock gateway enabled by default in dev)
PAYMENT_MOCK_ENABLED=true
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_UPI_PAYEE_ADDRESS=cartvia@razorpay
PAYMENT_UPI_PAYEE_NAME=CartVia

# Device / trolley
DEVICE_TOKEN_HEADER=X-Device-Token
TROLLEY_HEARTBEAT_TIMEOUT_SECONDS=180
